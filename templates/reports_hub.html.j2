<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Reports — {{ pool_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow:wght@400;500;600;700&display=swap">
<style>
  :root{
    --surface:#131a2b; --ink:#edeff5; --muted:#8993ac; --line:#232c44;
    --accent-afc:#ff5a48; --accent-nfc:#3e7bff; --gold:#ffc94a;
    --card:#0f1523; --bg:#0b0f1a;
    --font-display:'Anton',sans-serif; --font-body:'Barlow',sans-serif;
  }
  *{box-sizing:border-box;}
  body{background:var(--bg); color:var(--ink); font-family:var(--font-body); margin:0; padding:20px 16px 60px;}
  .wrap{max-width:820px; margin:0 auto;}

  .board{border-radius:16px; padding:clamp(16px,3vw,32px); background:linear-gradient(180deg,var(--surface),var(--card));}
  .backlink{display:inline-block; color:var(--muted); font-size:.78rem; font-weight:600; text-decoration:none; margin-bottom:16px;}
  .backlink:hover{color:var(--ink);}
  .backlink::before{content:"← "; }

  h1{font-family:var(--font-display); font-weight:400; text-transform:uppercase; letter-spacing:.01em; font-size:2.1rem; line-height:1; margin:0 0 8px;}
  .subtitle{color:var(--muted); font-size:.95rem; margin:0 0 26px; line-height:1.5;}

  .cards{display:flex; flex-direction:column; gap:12px;}
  .card{display:flex; align-items:center; justify-content:space-between; gap:16px; background:var(--card); border:1px solid var(--line); border-radius:14px; padding:18px 22px; text-decoration:none; color:var(--ink); transition:border-color .15s, transform .1s;}
  .card:hover{border-color:var(--accent-afc);}
  .card .ctitle{font-family:var(--font-display); font-weight:400; text-transform:uppercase; letter-spacing:.01em; font-size:1.25rem; margin-bottom:3px;}
  .card .csub{color:var(--muted); font-size:.85rem;}
  .card .arrow{font-family:var(--font-display); font-size:1.5rem; color:var(--accent-afc); flex-shrink:0;}
  .card.featured{border-color:var(--gold);}
  .card.featured .ctitle{color:var(--gold);}

  @media (max-width:480px){
    h1{font-size:1.6rem;}
    .card{padding:14px 16px;}
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="board">
    <a class="backlink" href="index.html">Back to leaderboard</a>
    <h1>Reports</h1>
    <p class="subtitle">The preseason scouting report, plus a fresh write-up after every week's standings update.</p>

    <div class="cards">
      {% for r in reports %}
      <a class="card {{ 'featured' if r.featured else '' }}" href="{{ r.href }}">
        <div>
          <div class="ctitle">{{ r.title }}</div>
          <div class="csub">{{ r.subtitle }}</div>
        </div>
        <div class="arrow">→</div>
      </a>
      {% endfor %}
    </div>
  </div>
</div>
</body>
</html>
