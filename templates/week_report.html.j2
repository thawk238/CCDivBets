<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — {{ pool_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow:wght@400;500;600;700&display=swap">
<style>
  :root{
    --surface:#131a2b; --ink:#edeff5; --muted:#8993ac; --line:#232c44;
    --accent-afc:#ff5a48; --accent-nfc:#3e7bff; --gold:#ffc94a; --ok:#39d27a;
    --card:#0f1523; --chipbg:#1b2338; --bg:#0b0f1a; --leaderbg:#1d1408;
    --font-display:'Anton',sans-serif; --font-body:'Barlow',sans-serif;
  }
  *{box-sizing:border-box;}
  body{background:var(--bg); color:var(--ink); font-family:var(--font-body); margin:0; padding:20px 16px 60px;}
  .wrap{max-width:820px; margin:0 auto;}

  .board{border-radius:16px; padding:clamp(16px,3vw,32px); background:linear-gradient(180deg,var(--surface),var(--card));}
  .backlink{display:inline-block; color:var(--muted); font-size:.78rem; font-weight:600; text-decoration:none; margin-bottom:16px;}
  .backlink:hover{color:var(--ink);}
  .backlink::before{content:"← "; }

  h1{font-family:var(--font-display); font-weight:400; text-transform:uppercase; letter-spacing:.01em; font-size:2.1rem; line-height:1; margin:0 0 8px;}
  .subtitle{color:var(--gold); font-size:1rem; font-weight:600; margin:0 0 22px;}

  .intro p{font-size:1.02rem; line-height:1.65; color:var(--ink); margin:0 0 14px;}

  .section-title{font-family:var(--font-display); font-weight:400; text-transform:uppercase; letter-spacing:.01em; font-size:1.25rem; margin:28px 0 4px;}
  .section-sub{color:var(--muted); font-size:.82rem; margin:0 0 14px;}

  .lb{width:100%; border-collapse:collapse; font-variant-numeric:tabular-nums; margin-bottom:8px;}
  .lb th{text-align:left; font-size:.68rem; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); font-weight:700; padding:0 8px 8px; border-bottom:1px solid var(--line);}
  .lb td{padding:8px 8px; border-bottom:1px solid var(--line); font-size:.86rem;}
  .lb tr:last-child td{border-bottom:none;}
  .lb th:not(:first-child), .lb td:not(:first-child){text-align:center;}
  .lb th:nth-child(2), .lb td:nth-child(2){text-align:left;}
  .lb tr.leader{background:var(--leaderbg);}
  .lb .total{font-family:var(--font-display); font-weight:400; color:var(--accent-afc);}
  .lb tr.leader .total{color:var(--gold);}
  .delta{font-size:.72rem; font-weight:700;}
  .delta.up{color:var(--ok);}
  .delta.down{color:var(--accent-afc);}

  .lockrow{display:flex; flex-wrap:wrap; gap:8px; margin:16px 0 26px;}
  .lockstat{display:flex; align-items:center; gap:7px; background:var(--card); border:1px solid var(--line); border-radius:20px; padding:6px 12px; font-size:.76rem;}
  .lockstat .dot{width:8px; height:8px; border-radius:50%; flex-shrink:0;}
  .lockstat.hold .dot{background:var(--ok);}
  .lockstat.broke .dot{background:var(--accent-afc);}
  .lockstat .desc{color:var(--muted);}
  .lockstat .desc b{color:var(--ink); font-weight:700;}

  .fact{margin:26px 0;}
  .fact h2{font-family:var(--font-display); font-weight:400; text-transform:uppercase; letter-spacing:.01em; font-size:1.25rem; color:var(--accent-afc); margin:0 0 8px;}
  .fact p{font-size:.96rem; line-height:1.65; color:var(--ink); margin:0 0 10px;}

  .closing{margin-top:34px; padding-top:18px; border-top:1px solid var(--line); color:var(--muted); font-size:.85rem; line-height:1.6; font-style:italic;}

  @media (max-width:480px){
    h1{font-size:1.6rem;}
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="board">
    <a class="backlink" href="../reports.html">Back to reports</a>
    <h1>{{ title }}</h1>
    <p class="subtitle">{{ subtitle }}</p>

    <div class="intro">
      {% for p in intro_paragraphs %}<p>{{ p }}</p>{% endfor %}
    </div>

    <div class="section-title">Standings After Week {{ week }}</div>
    <table class="lb">
      <thead><tr><th>#</th><th>Bettor</th><th>Total</th><th>Change</th></tr></thead>
      <tbody>
        {% for row in leaderboard %}
        <tr class="{{ 'leader' if row.rank == 1 else '' }}">
          <td>{{ row.rank }}</td>
          <td>{{ row.name }}</td>
          <td class="total">{{ row.total }}</td>
          <td>
            {% if row.delta is not none %}
            <span class="delta {{ 'up' if row.delta > 0 else ('down' if row.delta < 0 else '') }}">{{ '+' if row.delta > 0 else '' }}{{ row.delta }}</span>
            {% else %}
            <span style="color:var(--muted);">—</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="section-title">Preseason Locks: Status Check</div>
    <div class="section-sub">{{ locks_holding }} of {{ locks_holding + locks_broken }} unanimous preseason picks are still holding up.</div>
    <div class="lockrow">
      {% for lock in lock_status %}
      <div class="lockstat {{ 'hold' if lock.holding else 'broke' }}">
        <span class="dot"></span>
        <span class="desc"><b>{{ lock.predicted_team }}</b> {{ lock.division_name }} — {{ 'holding' if lock.holding else 'now ' ~ lock.actual_team_name }}</span>
      </div>
      {% endfor %}
    </div>

    {% for f in fun_facts %}
    <div class="fact">
      <h2>{{ f.heading }}</h2>
      {% for para in f.body_paragraphs %}<p>{{ para }}</p>{% endfor %}
    </div>
    {% endfor %}

    <div class="closing">{{ closing_paragraph }}</div>
  </div>
</div>
</body>
</html>
